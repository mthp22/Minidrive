{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Minidrive": "Debug"
    }
  },

  // Stock local-development defaults so `dotnet run` works against a freshly installed
  // MongoDB and MinIO without any extra configuration:
  //   * MongoDB on mongodb://localhost:27017
  //   * MinIO (or any S3-compatible store) on http://127.0.0.1:9000 with the factory-default
  //     credentials and a bucket named "minidrive" (create it once, see backend/README.md)
  // These are well-known local defaults, never real secrets; environment variables take
  // precedence over this file, and production configuration supplies its own values.
  "MongoDB": {
    "ConnectionString": "mongodb://localhost:27017"
  },
  "CloudflareR2": {
    "Endpoint": "http://127.0.0.1:9000",
    // MinIO signs against its configured region (default us-east-1); Cloudflare R2 uses "auto".
    "Region": "us-east-1",
    "AccessKeyId": "minioadmin",
    "SecretAccessKey": "minioadmin",
    "BucketName": "minidrive"
    // ForcePathStyle defaults to true, which is what MinIO (and R2) expect.
  },

  // Local development convenience: mint tokens with POST /api/v1/auth/dev-token instead of
  // standing up an identity provider. Startup validation forbids this flag outside Development.
  "Authentication": {
    "EnableDevTokenEndpoint": true
  }
}
