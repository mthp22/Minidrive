# -----------------------------------------------------------------------------
# Minidrive backend — environment variable template.
#
# Copy to `.env` (git-ignored) and load it before running the API:
#
#     set -a && source .env && set +a
#     dotnet run --project backend/src/Minidrive.Api
#
# .NET maps these to configuration with `__` as the section separator, e.g.
# `MongoDB__ConnectionString` -> configuration["MongoDB:ConnectionString"].
# NEVER put real credentials in this file or commit a filled-in `.env`.
# -----------------------------------------------------------------------------

# --- MongoDB (metadata store) ------------------------------------------------
# Required. Standard MongoDB connection string; never logged by the application.
MongoDB__ConnectionString=mongodb://localhost:27017
MongoDB__DatabaseName=minidrive
# Create the documented indexes during startup (default: true).
MongoDB__EnsureIndexesOnStartup=true

# --- Object storage (MinIO locally, Cloudflare R2 in production) --------------
# Required at startup: the API fails fast if object storage is not fully configured.
# The client is a plain S3 client with path-style addressing, so any S3-compatible
# service works.
#
# Local development with MinIO (the values below match a stock install):
#   1. run MinIO:          minio server ./data      # S3 on :9000, console on :9001
#   2. create the bucket:  mc mb local/minidrive    # or via the console at :9001
#   (In Development these same defaults ship in appsettings.Development.json,
#    so a stock local MinIO works even without this file.)
CloudflareR2__Endpoint=http://127.0.0.1:9000
CloudflareR2__AccessKeyId=minioadmin
CloudflareR2__SecretAccessKey=minioadmin
CloudflareR2__BucketName=minidrive
# MinIO signs with its configured region (default us-east-1). For Cloudflare R2 use "auto".
CloudflareR2__Region=us-east-1
CloudflareR2__ForcePathStyle=true
# CloudflareR2__AccountId=   # production alternative to Endpoint: the endpoint is derived as
#                             # https://<AccountId>.r2.cloudflarestorage.com; leave Endpoint unset
#                             # and put real credentials from the R2 dashboard here instead.

# --- Authentication (JWT bearer) --------------------------------------------
# Required outside the Development environment: a token signed with a shared
# secret of at least 32 characters. Generate one with:
#     openssl rand -base64 48
# In Development an ephemeral key is generated when this is left empty, so no
# secret ever has to be committed.
Authentication__Issuer=minidrive
Authentication__Audience=minidrive-api
Authentication__SigningKey=
Authentication__TokenLifetimeMinutes=60
# Development-only convenience (startup validation rejects it elsewhere):
Authentication__EnableDevTokenEndpoint=false

# --- Uploads -----------------------------------------------------------------
# Part size handed to clients; must stay >= 5 MiB (S3/R2 minimum for
# non-final parts). 10 MiB is the default.
Uploads__ChunkSizeBytes=10485760
Uploads__MaxFileSizeBytes=5368709120
Uploads__PresignedUrlExpirationMinutes=60
Uploads__UploadSessionLifetimeHours=24
# Per-user storage quota in bytes; 0 disables quota enforcement.
Uploads__QuotaBytesPerUser=0

# --- Maintenance (deferred cleanup worker) -----------------------------------
# Expires abandoned upload sessions and deletes the storage objects of
# soft-deleted nodes.
Maintenance__Enabled=true
Maintenance__IntervalSeconds=300
Maintenance__BatchSize=100

# --- Kestrel (optional) ------------------------------------------------------
# ASPNETCORE_URLS=http://localhost:5080
