{
  "$schema": "https://json.schemastore.org/appsettings.json",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Minidrive": "Information"
    }
  },
  "AllowedHosts": "*",

  // MongoDB metadata store. Provide the connection string through an environment variable
  // (MongoDB__ConnectionString) or a local override; no real deployment value is committed.
  "MongoDB": {
    "ConnectionString": "",
    "DatabaseName": "minidrive",
    "EnsureIndexesOnStartup": true
  },

  // Cloudflare R2 (S3-compatible). Supply credentials via environment variables
  // (CloudflareR2__AccessKeyId / CloudflareR2__SecretAccessKey). Startup fails fast when these
  // are missing, which is intentional: the API cannot function without object storage.
  "CloudflareR2": {
    "AccountId": "",
    "Endpoint": "",
    "AccessKeyId": "",
    "SecretAccessKey": "",
    "BucketName": "minidrive",
    "Region": "auto",
    "ForcePathStyle": true
  },

  "Uploads": {
    // Part size handed to clients. Must stay at or above the 5 MiB S3/R2 minimum for
    // non-final parts; 10 MiB is the default.
    "ChunkSizeBytes": 10485760,
    "MaxFileSizeBytes": 5368709120,
    "PresignedUrlExpirationMinutes": 60,
    "UploadSessionLifetimeHours": 24,
    // 0 disables quota enforcement.
    "QuotaBytesPerUser": 0
  },

  "Maintenance": {
    "Enabled": true,
    "IntervalSeconds": 300,
    "BatchSize": 100
  },

  "Authentication": {
    "Issuer": "minidrive",
    "Audience": "minidrive-api",
    // Required outside Development. In Development an ephemeral key is generated at startup so
    // no secret ever has to be committed here.
    "SigningKey": "",
    "TokenLifetimeMinutes": 60,
    // Development only; startup validation rejects this flag outside Development.
    "EnableDevTokenEndpoint": false
  }
}
